# Production secrets/config for docker-compose.prod.yml.
# On the server: `cp .env.prod.example .env.prod` and fill in the blanks.
# This single file is used both for compose interpolation (--env-file .env.prod)
# and injected into the containers (env_file). Never commit the real .env.prod.

APP_NAME="Ewidencja Środków Trwałych"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                      # docker compose ... run --rm app php artisan key:generate --show
APP_URL=https://twoja-subdomena.wykr.es
APP_TIMEZONE=Europe/Warsaw
APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pl_PL

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Database — DB_HOST=db points at the postgres service on the internal network.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=asset_inventory
DB_USERNAME=app
DB_PASSWORD=                  # openssl rand -base64 32

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Published port on the host — map this to a Mikr.us TCP port from the panel.
WEB_PORT=8080

# Optional: image reference when pulling pre-built images from GHCR (CI/CD).
# APP_IMAGE=ghcr.io/<owner>/asset-inventory:latest
