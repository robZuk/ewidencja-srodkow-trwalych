# Build context excludes — keep the production image lean and reproducible.
# vendor/ and node_modules/ are rebuilt inside the image; env files are injected
# at runtime (docker-compose env_file), never baked in.
.git
.github
.gitignore
.gitattributes

node_modules
vendor

.env
.env.*
!.env.prod.example

public/build
public/hot
public/storage

storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*

tests
docs
*.md
.phpunit.result.cache
.phpunit.cache
.phpactor.json
.idea
.vscode
